{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "nli": {
      "root": "clinical-interceptor/nli_service",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "nli" } }],
  "crons": [{ "path": "/v1/health", "schedule": "*/3 * * * *" }]
}
