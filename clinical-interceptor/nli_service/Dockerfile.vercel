# NLI inference service: the approved checkpoint behind an HTTP API.
#
# The name is Dockerfile.vercel because Vercel looks for that name when a service points at it. The same image
# builds and runs anywhere: it is an ordinary OCI image that listens on $PORT.
#
# The checkpoint is baked into the image, so the service starts without a download. It is about 750 MB, and the
# lock file (models/nli/MODEL.lock) says which bytes are approved, so the image carries a checkpoint that can be
# checked rather than one that has to be trusted. The build fails if a byte does not match.
#
#   docker build -f nli_service/Dockerfile.vercel -t clinical-nli .
#   docker run --rm -p 8100:8100 clinical-nli
#
# Set NLI_BAKE_MODEL=0 to build the image without the weights, for a host that mounts them instead.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    NLI_BAKE_MODEL=1 \
    NLI_MODEL_PATH=/models/nli/cross-encoder-nli-deberta-v3-base \
    NLI_MODEL_LOCK=/models/nli/MODEL.lock \
    PORT=8100

WORKDIR /app

# libgomp1 is what torch needs for its OpenMP kernels.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-nli.txt ./
RUN pip install -r requirements-nli.txt

COPY src ./src
COPY nli_service ./nli_service
COPY tools ./tools
COPY models/nli/MODEL.lock ./models/nli/MODEL.lock

# The approved checkpoint, fetched at the revision the lock names and checked against the lock.
RUN if [ "$NLI_BAKE_MODEL" = "1" ]; then \
      mkdir -p "$(dirname "$NLI_MODEL_PATH")" && \
      PYTHONPATH=/app/src python tools/fetch_nli_model.py --out "$NLI_MODEL_PATH"; \
    fi

RUN useradd --create-home --uid 10002 nli && chown -R nli /app
USER nli

ENV PYTHONPATH=/app/src
EXPOSE 8100

# One worker: the model is loaded once per worker, and the checkpoint does not fit twice in memory.
CMD ["sh", "-c", "exec python -m uvicorn nli_service.app:app --host 0.0.0.0 --port ${PORT:-8100} --workers 1"]
