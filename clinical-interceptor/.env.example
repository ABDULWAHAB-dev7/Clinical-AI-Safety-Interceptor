# Copy to .env and fill in. Never commit real values.
INTERCEPTOR_DATABASE_URL=postgresql://postgres:dev-only-password@127.0.0.1:5432/interceptor
INTERCEPTOR_PSEUDO_KEY=change-me-at-least-32-random-characters
INTERCEPTOR_JWT_PUBLIC_KEY_FILE=seed/certs/jwt_public.pem
INTERCEPTOR_MTLS_REGISTRY=seed/certs/registry.json
# Reverse-proxy mTLS mode (leave unset for the direct dev TLS server)
# INTERCEPTOR_TRUSTED_PROXIES=10.0.0.5
# INTERCEPTOR_PROXY_SECRET=
INTERCEPTOR_UPSTREAM_BASE_URL=
INTERCEPTOR_UPSTREAM_API_KEY=
# INTERCEPTOR_MODEL_ROUTES=
INTERCEPTOR_RATE_LIMIT_PER_MINUTE=60
# Seconds to wait for a connection to the database. A cold function in a cold region can take a while.
INTERCEPTOR_DB_CONNECT_TIMEOUT_SECONDS=10
# NLI scorer. "none" (default) blocks the claims the rules cannot settle; "local" loads the checkpoint in this
# process; "remote" calls a self-hosted inference service (INTERCEPTOR_NLI_ENDPOINT).
# INTERCEPTOR_NLI_MODE=none
# INTERCEPTOR_NLI_MODEL_PATH=models/nli/cross-encoder-nli-deberta-v3-base
# INTERCEPTOR_NLI_MODEL_LOCK=models/nli/MODEL.lock
# INTERCEPTOR_NLI_ENDPOINT=http://nli:8100
# INTERCEPTOR_NLI_TOKEN=
# NLI inference service (nli_service/)
# NLI_MODEL_PATH=models/nli/cross-encoder-nli-deberta-v3-base
# NLI_MODEL_LOCK=models/nli/MODEL.lock
# NLI_SERVICE_TOKEN=
# NLI scorer (no checkpoint is chosen yet, see README open decisions)
# INTERCEPTOR_NLI_MODEL_PATH=
# INTERCEPTOR_NLI_MODEL_LOCK=
# Database tests
# INTERCEPTOR_TEST_DSN=host=127.0.0.1 port=5432 dbname=interceptor_test user=postgres
